# Fake Proxmox credentials for tests/scripts/*.bats. The token
# is the all-zero placeholder the repository's gitleaks rules allow; nothing
# here reaches a hypervisor.
PROXMOX_URL=https://pve.example.invalid:8006/api2/json
PROXMOX_USERNAME=build@pve!test
PROXMOX_TOKEN=00000000-0000-0000-0000-000000000000
