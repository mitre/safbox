{#- The certificates every configured bundle holds, as JSON: one entry per
    certificate with its bundle, the anchor file it is installed as
    (safbox-<bundle>-<id>.<ext>, the id the first 16 hex digits of the
    SHA-256 of its PEM text, so a file name follows its certificate), and
    the PEM text. Read from the output of the conversion task. -#}
{%- set ns = namespace(certificates=[]) -%}
{%- for result in site_config_trust_read.results -%}
{%-   for pem in result.stdout | regex_findall('-----BEGIN CERTIFICATE-----\n[A-Za-z0-9+/=\n]+?-----END CERTIFICATE-----') -%}
{%-     set ns.certificates = ns.certificates + [{
          'bundle': result.item.name,
          'file': 'safbox-' ~ result.item.name ~ '-' ~ (pem | hash('sha256'))[:16] ~ '.' ~ site_config_trust_anchor_ext,
          'pem': pem ~ '\n'}] -%}
{%-   endfor -%}
{%- endfor -%}
{{ ns.certificates | to_json }}
