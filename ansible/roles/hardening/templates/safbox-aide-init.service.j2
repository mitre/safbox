# Written by the SAFBox hardening role. Makes the AIDE database of this box
# once, after its first boot has configured it, so the database describes
# the deployed box, never the template it was cloned from.
[Unit]
Description=Make the AIDE database of this box
After={{ hardening_firstboot_unit }}
ConditionPathExists={{ hardening_firstboot_done_marker }}
ConditionPathExists=!{{ hardening_aide_db }}

[Service]
Type=oneshot
ExecStart=/usr/sbin/aide --init
ExecStart=/usr/bin/mv -f {{ hardening_aide_db_new }} {{ hardening_aide_db }}

[Install]
WantedBy=multi-user.target
