# {{ ansible_managed }}
# Trivial Quadlet unit: proves the container runtime starts a unit on boot.
# Least privilege: a memory limit, no added capabilities, no network, a
# read-only root.
[Unit]
Description=SAFBox container runtime smoke test
After=safbox-firstboot.service

[Container]
Image={{ platform_container_example_image }}
ContainerName={{ platform_container_example_name }}
Network=none
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
MemoryMax={{ platform_container_example_memory_max }}

[Install]
WantedBy=multi-user.target
