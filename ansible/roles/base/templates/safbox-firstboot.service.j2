# {{ ansible_managed }}
# Runs once on the first boot of a deployed SAFBox and never again: the
# first-boot play writes the done marker as its last task, and the marker
# satisfies the condition on every later boot. The seal role removes the
# marker from the template so each clone starts fresh. A failed run leaves
# no marker and is retried next boot.
#
# Ordered after cloud-config.service: by then cloud-init has applied the
# instance's network, hostname, users and keys. Not after cloud-init.target
# or cloud-final.service: those are ordered after multi-user.target, which
# wants this unit, and systemd breaks that cycle by deleting this job.
#
# The play runs with the box's own ansible-core, locally and offline. Its
# configuration keeps module invocations out of the system log and Ansible's
# temporary files in this unit's runtime directory; its output, with the
# secrets censored, goes to the journal.
[Unit]
Description=SAFBox first boot: disk growth, accounts, per-install secrets and the proxy's certificate
Documentation=file:{{ base_firstboot_play }}
ConditionPathExists=!{{ base_firstboot_done_marker }}
Wants=network-online.target
After=network-online.target cloud-config.service
{% if base_firstboot_before_units | length > 0 %}
Before={{ base_firstboot_before_units | join(' ') }}
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=ANSIBLE_CONFIG={{ base_firstboot_play_dir }}/ansible.cfg HOME=/root
RuntimeDirectory=safbox-firstboot
ExecStart=/usr/bin/ansible-playbook -c local -i localhost, {{ base_firstboot_play }}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=safbox-firstboot
UMask=0077

[Install]
WantedBy=multi-user.target
