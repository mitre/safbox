# {{ ansible_managed }}
# The SAFBox TLS proxy: the nginx service of upstream Heimdall's
# docker-compose.yml (https://github.com/mitre/heimdall2/blob/master/docker-compose.yml)
# and the nginx profile of Vulcan's
# (https://github.com/mitre/vulcan/blob/master/docker-compose.yml), as one
# container for both applications (ADR-0001 §Decision: a single nginx
# reverse proxy).
#   image nginx:alpine                 -> Red Hat UBI 9 nginx, pinned by digest
#                                         (safbox_image_proxy): its OpenSSL runs
#                                         the FIPS provider on a FIPS host
#   ports 80, 443                      -> the same, on the host network
#                                         (nginx.conf): 443 serves each
#                                         application by name, 80 redirects
#   templates and certs volumes        -> nginx.conf and the start page
#                                         (services role) and the certificate
#                                         first boot generates, all read-only
# The host network lets nginx reach the pods' loopback-only ports. It runs as
# root (master) to read the root-only key, with every capability dropped but
# the three nginx needs to hand work to its nginx-user workers and the one
# it needs to bind ports 80 and 443 (below 1024).
[Unit]
Description=SAFBox TLS proxy (nginx)
After=safbox-firstboot.service
ConditionPathExists={{ services_proxy_key }}

[Container]
Image={{ services_proxy_image }}
ContainerName=safbox-proxy
Network=host
User=root
Exec=nginx -c /etc/nginx/safbox/nginx.conf
Volume={{ services_proxy_conf_dir }}:/etc/nginx/safbox:ro,Z
Volume={{ services_proxy_tls_dir }}:/etc/nginx/tls:ro,Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_CHOWN CAP_SETGID CAP_SETUID CAP_NET_BIND_SERVICE
Memory={{ services_proxy_memory }}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
