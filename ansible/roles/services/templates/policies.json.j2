{#- Firefox enterprise policy (services role, task group safbox-services-4).
    The applications' and the start page's bookmarks need the proxy, as
    does the homepage, the start page (unlocked: users may change it).
    NoDefaultBookmarks drops the distribution's default bookmarks: Firefox's
    first-run import of them races the Bookmarks policy and loses one of
    the box's. -#}
{% set proxy = safbox_services_3 | default(true) | bool %}
{
  "policies": {
    "DisplayBookmarksToolbar": "always",
    "NoDefaultBookmarks": true,
{% if proxy %}
    "Homepage": {"URL": {{ ('https://' ~ safbox_domain ~ '/') | to_json }}, "StartPage": "homepage", "Locked": false},
{% endif %}
    "Bookmarks": [
{% if proxy %}
{% for app in services_proxy_apps if app.enabled | bool %}
      {"Title": {{ app.title | to_json }}, "URL": {{ ('https://' ~ app.host ~ app.path | default('/')) | to_json }}, "Placement": "toolbar"},
{% endfor %}
{% endif %}
      {"Title": "SAF", "URL": "https://saf.mitre.org", "Placement": "toolbar"},
      {"Title": "SAF Training", "URL": "https://mitre.github.io/saf-training/", "Placement": "toolbar"}{{ ',' if proxy }}
{% if proxy %}
      {"Title": "SAFBox - Start Here", "URL": {{ ('https://' ~ safbox_domain ~ '/') | to_json }}, "Placement": "toolbar"}
{% endif %}
    ]
  }
}
