# {{ ansible_managed }}
# The vulcan pod: Vulcan and its PostgreSQL share one network namespace, as
# the web and db services of upstream's docker-compose.yml
# (https://github.com/mitre/vulcan/blob/master/docker-compose.yml) share a
# network. Upstream publishes web on ${VULCAN_PORT:-3000} and, behind a
# proxy, only exposes it; here the pod publishes it on the loopback address
# only, for the TLS proxy, on the port upstream suggests for running beside
# another service (VULCAN_PORT=3001). The database is published nowhere.
# Starts only after first boot has written Vulcan's secrets.
[Unit]
Description=Vulcan pod (Vulcan and its PostgreSQL)
After=safbox-firstboot.service
ConditionPathExists={{ services_vulcan_env_file }}

[Pod]
PodName=vulcan
Network=vulcan.network
PublishPort=127.0.0.1:{{ services_vulcan_loopback_port }}:3000
{% if services_keycloak_enabled | bool %}
# Inside the pod 127.0.0.1 is the pod itself, where nothing serves
# Keycloak's name: podman's host-gateway is the host's address on the
# pod's network, where the TLS proxy answers on 443, so Vulcan reaches
# Keycloak at the issuer URL the browser uses.
AddHost={{ services_keycloak_host }}:host-gateway
{% endif %}

[Install]
WantedBy=multi-user.target
