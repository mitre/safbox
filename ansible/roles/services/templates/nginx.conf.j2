# {{ ansible_managed }}
# SAFBox TLS proxy: name-based virtual hosts on 443, one per enabled
# application (<application>.{{ safbox_domain }}), proxying to the
# application's pod on the loopback address, and a default server with the
# start page for every other name and the bare address. Port 80 redirects
# to HTTPS.
#
# The master process runs as root only to read the root-only key; workers
# run as nginx. Writable paths are under /tmp, the tmpfs podman mounts on
# the read-only root filesystem.
user nginx;
worker_processes auto;
daemon off;
pid /tmp/nginx.pid;
error_log stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    sendfile on;
    keepalive_timeout 65;

    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    # TLS follows the system crypto policy, which on a FIPS host is the FIPS
    # policy podman maps into the container: PROFILE=SYSTEM takes the
    # policy's TLS 1.2 cipher list, and TLS 1.3 suites come from the policy
    # through OpenSSL's configuration. Both applications' upstream examples
    # name TLS 1.2 and 1.3; the policy forbids anything older. One
    # certificate names every server below (first boot, 40-proxy.sh).
    ssl_certificate /etc/nginx/tls/safbox.crt;
    ssl_certificate_key /etc/nginx/tls/safbox.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers PROFILE=SYSTEM;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # A plain HTTP request on an HTTPS port is redirected to HTTPS on the
    # same name and path (nginx's code 497) instead of answered with 400.
    error_page 497 =301 https://$host$request_uri;

    # Port 80, after the redirect server of Heimdall's upstream
    # nginx/conf/default.conf.template, for every name: $host, since one
    # server answers them all.
    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # The default server: {{ safbox_domain }}, the bare address and any name
    # not below get the start page, the SAFBox documentation site, with the
    # status.json the welcome page reads.
    server {
        listen 443 ssl default_server;
        http2 on;
        server_name {{ safbox_domain }};
        root /etc/nginx/safbox/html;
        # An error_page here replaces every inherited one, so the
        # plain-HTTP-to-HTTPS redirect (497) is repeated.
        error_page 497 =301 https://$host$request_uri;
        error_page 404 /404.html;

        location / {
            try_files $uri $uri.html $uri/index.html =404;
        }
        location = /status.json {
            add_header Cache-Control "no-store";
        }
    }
{% for app in services_proxy_apps if app.enabled | bool %}
{% if app.name == 'heimdall' %}

    # Heimdall, after upstream's nginx/conf/default.conf.template
    # (https://github.com/mitre/heimdall2/blob/master/nginx/conf/default.conf.template):
    # its body limit and buffers, and the headers its proxy location sets.
    # Not reproduced: the try_files branch with its CORS header, which
    # serves files from nginx's own root, empty here, so every request
    # reaches Heimdall.
    server {
        listen 443 ssl;
        http2 on;
        server_name {{ app.host }};

        client_max_body_size 100m;

        location / {
            proxy_buffers 32 5m;
            proxy_buffer_size 5m;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $http_host;
            proxy_set_header X-NginX-Proxy true;
            proxy_pass http://127.0.0.1:{{ app.loopback_port }};
            proxy_redirect off;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
{% elif app.name == 'vulcan' %}

    # Vulcan, after upstream's nginx.conf.example
    # (https://github.com/mitre/vulcan/blob/master/nginx.conf.example): its
    # forwarded headers, read timeout and WebSocket support, with
    # RAILS_FORCE_SSL on in the container. Host and X-Forwarded-Host are
    # $http_host, the name the client asked for. Body limit 100m, Vulcan's
    # own upload limit (nginx's default is 1m). Not reproduced: gzip
    # (compressing pages that carry CSRF tokens over TLS invites BREACH),
    # and the /assets/ cache headers, which Rails sends itself.
    server {
        listen 443 ssl;
        http2 on;
        server_name {{ app.host }};

        client_max_body_size 100m;

        location / {
            proxy_pass http://127.0.0.1:{{ app.loopback_port }};
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_read_timeout 90;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
{% elif app.name == 'keycloak' %}

    # Keycloak, after Keycloak's reverse-proxy guide
    # (https://www.keycloak.org/server/reverseproxy): the X-Forwarded-*
    # headers are set here, overwriting any a client sent, and Keycloak
    # believes them from its network's gateway only (keycloak.container);
    # the buffers fit its large response headers. The guide advises
    # against exposing the administration console and the master realm:
    # they answer to the box itself only (its names map to 127.0.0.1).
    server {
        listen 443 ssl;
        http2 on;
        server_name {{ app.host }};

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        location / {
            proxy_pass http://127.0.0.1:{{ app.loopback_port }};
        }
        location ^~ /admin/ {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            proxy_pass http://127.0.0.1:{{ app.loopback_port }};
        }
        location ^~ /realms/master/ {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            proxy_pass http://127.0.0.1:{{ app.loopback_port }};
        }
    }
{% endif %}
{% endfor %}
}
