# {{ ansible_managed }}
# The heimdall pod: Heimdall and its PostgreSQL share one network namespace,
# as the server and database services of upstream's docker-compose.yml
# (https://github.com/mitre/heimdall2/blob/master/docker-compose.yml) share
# a network. Upstream's server publishes "3000"; here the pod publishes it
# on the loopback address only, for the TLS proxy (ADR-0001 Quality
# Standards: services bind to the proxy, not to all interfaces). The
# database is published nowhere. Starts only after first boot has written
# Heimdall's secrets.
[Unit]
Description=Heimdall pod (Heimdall and its PostgreSQL)
After=safbox-firstboot.service
ConditionPathExists={{ services_heimdall_env_file }}

[Pod]
PodName=heimdall
Network=heimdall.network
PublishPort=127.0.0.1:{{ services_heimdall_loopback_port }}:3000
{% if services_keycloak_enabled | bool %}
# Inside the pod 127.0.0.1 is the pod itself, where nothing serves
# Keycloak's name: podman's host-gateway is the host's address on the
# pod's network, where the TLS proxy answers on 443, so Heimdall reaches
# Keycloak at the issuer URL the browser uses.
AddHost={{ services_keycloak_host }}:host-gateway
{% endif %}

[Install]
WantedBy=multi-user.target
