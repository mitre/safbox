# {{ ansible_managed }}
# Vulcan's PostgreSQL: the db service of upstream's docker-compose.yml
# (https://github.com/mitre/vulcan/blob/master/docker-compose.yml), from a
# different image.
#   image postgres:18-alpine           -> the sclorg PostgreSQL 18 image on
#                                         CentOS Stream 9, pinned by digest
#                                         (safbox_image_postgresql): Alpine's
#                                         OpenSSL has no FIPS provider, this
#                                         one's runs it on a FIPS host. Its
#                                         interface differs: the variables
#                                         below, data in /var/lib/pgsql/data,
#                                         user 26, and glibc's collations
#                                         rather than musl's
#   restart: unless-stopped            -> Restart=always
#   volumes vulcan_dbdata:/var/lib/postgresql -> the vulcan-db named volume
#   POSTGRES_USER, POSTGRES_DB         -> POSTGRESQL_USER and
#     (postgres, vulcan_production)       POSTGRESQL_DATABASE: Vulcan signs
#                                         in as a role of its own that owns
#                                         vulcan_production, not as the
#                                         superuser postgres
#   POSTGRES_PASSWORD                  -> POSTGRESQL_PASSWORD in
#                                         vulcan-db.env, written by first boot
#   expose "5432"                      -> reachable inside the pod only
#   healthcheck pg_isready, every 30s, -> pg_isready over the pod's loopback
#     timeout 10s, 5 retries              as Vulcan's role, with the same
#                                         timings: the image's first start
#                                         runs a socket-only server first,
#                                         so only TCP means ready. The unit
#                                         is ready once healthy, so Vulcan
#                                         starts after it (upstream:
#                                         depends_on service_healthy)
# Settings and access list: vulcan-postgresql.conf and vulcan-pg_hba.conf
# (templates/postgresql.conf.j2, pg_hba.conf.j2).
[Unit]
Description=Vulcan PostgreSQL
After=safbox-firstboot.service
ConditionPathExists={{ services_vulcan_db_env_file }}

[Container]
Image={{ services_vulcan_db_image }}
ContainerName=vulcan-db
Pod=vulcan.pod
Volume=vulcan-db.volume:/var/lib/pgsql/data
Volume={{ services_postgresql_conf_dir }}/vulcan-postgresql.conf:/opt/app-root/src/postgresql-cfg/safbox.conf:ro,Z
Volume={{ services_postgresql_conf_dir }}/vulcan-pg_hba.conf:/opt/app-root/src/pg_hba.conf:ro,Z
Environment=POSTGRESQL_USER={{ services_vulcan_db_user }}
Environment=POSTGRESQL_DATABASE={{ services_vulcan_db_name }}
EnvironmentFile={{ services_vulcan_db_env_file }}
HealthCmd=pg_isready -h 127.0.0.1 -U {{ services_vulcan_db_user }} -d {{ services_vulcan_db_name }}
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
Notify=healthy
Memory={{ services_vulcan_db_memory }}
NoNewPrivileges=true

[Service]
Restart=always
# The first start initialises the database and waits for a healthy check.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
