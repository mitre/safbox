# {{ ansible_managed }}
# Settings of an application's PostgreSQL container (the services role's
# PostgreSQL section in defaults/main.yml). The image includes every
# /opt/app-root/src/postgresql-cfg/*.conf at the end of its postgresql.conf
# on each start (https://github.com/sclorg/postgresql-container), where the
# unit mounts this file.

# Passwords are stored as SCRAM-SHA-256 (PostgreSQL 18's default, set so it
# cannot change unseen); MD5 is refused under FIPS anyway.
password_encryption = 'scram-sha-256'

# The access list beside this file, in place of the one the image writes
# into the data directory, which trusts the socket and the loopback.
hba_file = '/opt/app-root/src/pg_hba.conf'
