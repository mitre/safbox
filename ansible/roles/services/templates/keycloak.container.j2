# {{ ansible_managed }}
# Keycloak in FIPS strict mode, from the image built at image build
# (keycloak.Containerfile.j2), after Keycloak's server guides:
#   start --optimized       production mode, with the options the image was
#                           built with (FIPS strict, PostgreSQL, health)
#   HealthCmd               readiness (/health/ready) on the management
#                           port, 9000, inside the pod; the image has no
#                           curl, so bash sends the request, as Keycloak's
#                           health guide shows; Notify=healthy makes the
#                           unit ready only then, so units ordered after
#                           it, and the end of boot, wait for a Keycloak
#                           that serves
#   --import-realm          imports the safbox realm on the first start
#                           only (an existing realm is left alone), its
#                           ${...} placeholders filled from this environment
#   KC_DB_*                 its database in the pod, as a role of its own
#                           (keycloak-db.container); the password is in
#                           keycloak.env (first boot)
#   KC_CACHE=local          one node: no cluster stack (JGroups) listening
#   KC_HOSTNAME             the name the proxy serves Keycloak at, so every
#                           party (the browser, both applications) sees one
#                           issuer
#   KC_HTTP_ENABLED         plain HTTP inside the pod; the proxy terminates TLS
#   KC_PROXY_HEADERS        the proxy overwrites X-Forwarded-*, believed only
#   KC_PROXY_TRUSTED_ADDRESSES  from the keycloak network's gateway
#                           (keycloak.network)
#   KC_BOOTSTRAP_ADMIN_*    the temporary administrator of the master realm
#                           Keycloak makes on its first start; its password
#                           is in keycloak.env (first boot)
# Each enabled application's client secret comes from that application's
# own file, which the application reads too.
[Unit]
Description=Keycloak
Documentation=https://www.keycloak.org/server/fips
Requires=keycloak-db.service
After=keycloak-db.service safbox-firstboot.service
ConditionPathExists={{ services_keycloak_env_file }}

[Container]
Image={{ services_keycloak_image }}
ContainerName=keycloak
Pod=keycloak.pod
Exec=start --optimized --import-realm
Environment=KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/{{ services_keycloak_db_name }}
Environment=KC_DB_USERNAME={{ services_keycloak_db_user }}
Environment=KC_CACHE=local
Environment=KC_HOSTNAME=https://{{ services_keycloak_host }}
Environment=KC_HTTP_ENABLED=true
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_PROXY_TRUSTED_ADDRESSES={{ services_keycloak_gateway }}
Environment=KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
EnvironmentFile={{ services_keycloak_env_file }}
{% for app in services_keycloak_clients %}
EnvironmentFile={{ app.oidc_env_file }}
{% endfor %}
Volume={{ services_keycloak_conf_dir }}/safbox-realm.json:/opt/keycloak/data/import/safbox-realm.json:ro,Z
HealthCmd={ printf 'HEAD /health/ready HTTP/1.0\r\n\r\n' >&0; grep -q 'HTTP/1.0 200'; } 0<>/dev/tcp/localhost/9000
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s
Notify=healthy
Memory={{ services_keycloak_memory }}
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always
# The first start creates the schema and imports the realm.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
