# {{ ansible_managed }}
# The SAFBox TLS proxy: the nginx service of upstream Heimdall's
# docker-compose.yml (https://github.com/mitre/heimdall2/blob/master/docker-compose.yml)
# and the nginx profile of Vulcan's
# (https://github.com/mitre/vulcan/blob/master/docker-compose.yml), as one
# container for both applications (ADR-0001 §Decision: a single nginx
# reverse proxy).
#   image nginx:alpine                 -> Red Hat UBI 9 nginx, pinned by digest
#                                         (safbox_image_proxy): its OpenSSL runs
#                                         the FIPS provider on a FIPS host
#   ports 80, 443                      -> one HTTPS port per application on the
#                                         host network (nginx.conf); 443 is the
#                                         landing page's, and there is no plain
#                                         HTTP
#   templates and certs volumes        -> nginx.conf and the landing page from
#                                         the proxy role, the certificate first
#                                         boot generates, and the landing page's
#                                         status files, all read-only
# The host network lets nginx reach the pods' loopback-only ports. It runs as
# root (master) to read the root-only key, with every capability dropped but
# the three nginx needs to hand work to its nginx-user workers and the one it
# needs to listen on the landing page's port, 443, below 1024. The status
# directory is labelled shared (z), not private: the status service on the
# host writes into it while the container reads it. The status service is
# ordered before the proxy but not pulled in by it, so a proxy that fails
# and restarts never exhausts the status service's start limit; its timer
# starts it.
[Unit]
Description=SAFBox TLS proxy (nginx)
After=safbox-firstboot.service {{ proxy_status_unit }}.service
ConditionPathExists={{ proxy_key }}

[Container]
Image={{ proxy_image }}
ContainerName=safbox-proxy
Network=host
User=root
Exec=nginx -c /etc/nginx/safbox/nginx.conf
Volume={{ proxy_conf_dir }}:/etc/nginx/safbox:ro,Z
Volume={{ proxy_tls_dir }}:/etc/nginx/tls:ro,Z
Volume={{ proxy_status_dir }}:/etc/nginx/safbox-landing-status:ro,z
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_CHOWN CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
Memory={{ proxy_memory }}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
