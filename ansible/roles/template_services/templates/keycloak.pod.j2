{% from 'secrets.j2' import secret_conditions with context %}
# {{ ansible_managed }}
# The keycloak pod: Keycloak and its PostgreSQL share one network
# namespace. The pod publishes Keycloak's HTTP port on the loopback address
# only, so it is reachable only through the TLS proxy, like the heimdall
# and vulcan pods. The database is published nowhere. Starts only after
# first boot has made Keycloak's secrets.
[Unit]
Description=Keycloak pod (Keycloak and its PostgreSQL)
After=safbox-firstboot.service

[Pod]
PodName=keycloak
# Quadlet's default stops the pod once no container runs, as when the
# database restarts and takes the application with it; the containers
# could then not start again.
ExitPolicy=continue
Network=keycloak.network
PublishPort=127.0.0.1:{{ safbox_keycloak_loopback_port }}:8080

[Service]
# Started only once first boot has made every secret its containers read.
{{ secret_conditions(['keycloak', 'keycloak-db']) }}
[Install]
WantedBy=multi-user.target
