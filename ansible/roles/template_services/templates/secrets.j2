{#
  The podman secrets a Quadlet unit's containers read (template_services_secrets,
  defaults/main.yml, "Per-install secrets"). Imported by each unit's
  template with context:

    secret_lines(container)       a Secret= line for each secret the
                                  container reads, as the variable it reads
    secret_conditions(containers) an ExecCondition= line for each secret any
                                  of the containers reads, so the unit
                                  starts only once first boot has made them
#}
{% macro secret_lines(container) %}
{% for secret in template_services_secrets if container in secret.env %}
Secret={{ secret.name }},type=env,target={{ secret.env[container] }}
{% endfor %}
{% endmacro %}
{% macro secret_conditions(containers) %}
{% for secret in template_services_secrets if secret.env | select('in', containers) | list | length > 0 %}
ExecCondition=/usr/bin/podman secret exists {{ secret.name }}
{% endfor %}
{% endmacro %}
