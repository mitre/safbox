# {{ ansible_managed }}
# Access list of {{ template_services_postgresql_app }}'s PostgreSQL container (the services
# role's PostgreSQL section in defaults/main.yml), read through hba_file
# (postgresql.conf beside it). The first matching line decides; a
# connection no line matches is refused.
# TYPE  DATABASE  USER  ADDRESS  METHOD

# The database's own administrator, over the container's socket only:
# podman exec as the container's user, never a password.
local   all   postgres   peer

# The application's role, from inside its pod (the pod shares one network
# namespace), with its password, SCRAM-SHA-256 only. Any database it may
# connect to: its own, and the maintenance database postgres, which
# Vulcan's entrypoint lists databases through.
host   all   {{ template_services_postgresql_user }}   127.0.0.1/32   scram-sha-256
host   all   {{ template_services_postgresql_user }}   ::1/128        scram-sha-256
