#!/usr/bin/env bash
# safbox-site-status: write the start page's status.json, each listed
# service up or down, for the documentation site's live status table.
#   safbox-site-status <list> <status.json>
# Each line of <list> is "Title|unit|url" (url may be empty). Run by
# safbox-site-status.service after each listed unit starts and every minute
# from its timer; template_services role, task group safbox-services-3.
set -euo pipefail
list=${1:?list file}
out=${2:?status.json path}

tmp=$(mktemp "${out}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# JSON string escaping for the two characters a title or URL could carry.
esc() { local s=${1//\\/\\\\}; printf '%s' "${s//\"/\\\"}"; }
{
  printf '{"updated":"%s","services":[' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sep=
  while IFS='|' read -r title unit url; do
    case $title in ''|'#'*) continue ;; esac
    state=down
    if systemctl is-active --quiet "$unit"; then state=up; fi
    printf '%s{"name":"%s","url":"%s","state":"%s"}' "$sep" "$(esc "$title")" "$(esc "$url")" "$state"
    sep=,
  done < "$list"
  printf ']}\n'
} > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
