# Example credentials file for scripts/build.sh, clone-and-ssh.sh and
# delete-vm.sh.
# Every value here is a placeholder: replace each with your own.
#
# It holds the Proxmox API credentials and the cluster CA, nothing else.
# Site settings (node, pool, storage, VM ID...) go in
# packer/local.auto.pkrvars.hcl, which the scripts read; per-run options
# are set in the shell (each script's --help lists them).
#
# Install it where the scripts look by default, readable by you only (the
# scripts refuse the file unless its mode is 0600, since it holds the API
# token):
#
#   mkdir -p ~/.config/proxmox
#   cp scripts/example.env ~/.config/proxmox/packer.env
#   chmod 600 ~/.config/proxmox/packer.env
#
# or keep it elsewhere and name it with SAFBOX_PROXMOX_ENV=<path> in the
# shell. Never commit the filled-in copy. The scripts source this file as
# shell, but a variable already set in the shell wins over the value here.
# docs/guides/proxmox/build.md step 5 explains the token.

# The API URL: a node's address or name, port 8006.
PROXMOX_URL=https://pve.example.invalid:8006/api2/json
# The token ID, <user>@pve!<token-name>.
PROXMOX_USERNAME='build@pve!build-token'
# The token secret, the UUID `pveum user token add` printed once.
PROXMOX_TOKEN=00000000-0000-0000-0000-000000000000
# The cluster CA (/etc/pve/pve-root-ca.pem from a node), trusted by Packer
# and by the scripts' own API calls. Without it, the system trust store.
PROXMOX_CA_FILE=~/.config/proxmox/pve-root-ca.pem
