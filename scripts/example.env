# Example environment file for scripts/build.sh and scripts/clone-and-ssh.sh.
# Every value here is a placeholder: replace each with your own.
#
# Install it where the scripts look by default, readable by you only (the
# scripts refuse the file unless its mode is 0600, since it holds the API
# token):
#
#   mkdir -p ~/.config/proxmox
#   cp scripts/example.env ~/.config/proxmox/packer.env
#   chmod 600 ~/.config/proxmox/packer.env
#
# or keep it elsewhere and name it with SAFBOX_PROXMOX_ENV=<path> in the
# shell. Never commit the filled-in copy. The scripts source this file as
# shell after the shell's own environment, so a value set here wins. Each
# script's --help says what it reads; docs/guides/proxmox/build.md step 5
# explains the token.

# --- Required: the Proxmox API and the build token -------------------------
# The API URL: a node's address or name, port 8006.
PROXMOX_URL=https://pve.example.invalid:8006/api2/json
# The token ID, <user>@pve!<token-name>.
PROXMOX_USERNAME='build@pve!build-token'
# The token secret, the UUID `pveum user token add` printed once.
PROXMOX_TOKEN=00000000-0000-0000-0000-000000000000

# --- Required for scripts/clone-and-ssh.sh ----------------------------------
# The node holding the template, by name (not its address).
SAFBOX_NODE=pve-node
# The resource pool clones join; the token's grant on it authorizes them.
SAFBOX_POOL=safbox-pool

# --- VM ID ranges, FIRST-LAST, inside what the token may use ----------------
# build.sh gives the template the first ID in this range no VM holds
# (-var vm_id=N on the command line wins).
SAFBOX_TEMPLATE_IDS=1000-1009
# clone-and-ssh.sh gives a clone the first free ID in this range when no
# clone ID is given. Keep it apart from the template range.
SAFBOX_CLONE_IDS=1100-1199

# --- CA and TLS: trust the cluster's CA rather than turn verification off ---
# The cluster CA (/etc/pve/pve-root-ca.pem from a node), for Packer and,
# unless SAFBOX_CA_FILE is set, for the scripts' own API calls.
# SSL_CERT_FILE=~/.config/proxmox/pve-root-ca.pem
# The CA the scripts' API calls trust instead of SSL_CERT_FILE.
# SAFBOX_CA_FILE=~/.config/proxmox/pve-root-ca.pem
# 1 turns off TLS verification in the scripts' API calls: a throwaway lab
# only, since the token then goes to whoever answers.
# SAFBOX_INSECURE_TLS=0

# --- Optional: the clone test -----------------------------------------------
# cloud-init's user on the clone (default admin).
# SAFBOX_CLONE_USER=admin
# safuser's password on the clone, as an `openssl passwd -6` hash (default:
# first boot generates one). Single quotes keep the $ signs.
# SAFBOX_CLONE_PASSWORD='$6$<salt>$<hash>'
# The private key the clone's admin gets (default .build/clone_key).
# SAFBOX_SSH_KEY=~/.ssh/safbox_clone
# More public key files for admin, colon-separated; ECDSA or RSA >= 2048.
# SAFBOX_EXTRA_SSH_KEYS=~/.ssh/id_ecdsa.pub
# A site's inputs file for the release gate.
# SAFBOX_SITE_INPUTS=verify/local/site-inputs.yml
# The SSH client config CINC Auditor reads; /dev/null for none.
# SAFBOX_SSH_CONFIG=/dev/null
# Seconds to wait for the clone to finish booting (default 600).
# SAFBOX_READY_TIMEOUT=600
# 1 stops after the first SSH check, before the release gate (default 0).
# SAFBOX_SKIP_VALIDATE=0

# --- Optional: development -------------------------------------------------
# 1 makes a development build: installer_ssh = true allowed, build key kept.
# SAFBOX_DEV=0
# The kept build key the clone test tries when SSH fails on a development
# template (default: every kept key, newest first).
# SAFBOX_BUILD_KEY=.build/runs/<run id>/build_key
# The build user those diagnostics log in as (default packer).
# SAFBOX_BUILD_USER=packer
