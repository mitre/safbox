# Local-only notes (session handoff, drafts to file upstream)
*.local.md

# Packer
packer_cache/
*.pkrvars.hcl
!example.pkrvars.hcl
.packer.d/
crash.log

# macOS
.DS_Store

# beads issue tracker (embedded Dolt, local only)
.beads/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Ephemeral build keys
.build/

# Tool byproducts
__pycache__/
saf-cli.log
inspec.lock

# beads 1.3+ cooperative flock files (never deleted by bd)
*.gate.lock*

# agent stuff
.claude
.codex
CLAUDE.md

# Site overrides for Ansible variables
ansible/local.yml

# Third-party roles ansible-galaxy installs from ansible/requirements.yml
ansible/galaxy_roles/

# Symlink to the current build log (scripts/build.sh maintains it)
last.log

# Site validation overrides (inputs and thresholds a site names through the
# Packer variables build_gate_site_* or SAFBOX_SITE_* for the release gate)
verify/local/

# Terraform: site values, state and the provider cache of the deploy modules.
# Each module commits its example.tfvars and its .terraform.lock.hcl.
*.tfvars
!example.tfvars
*.tfstate
*.tfstate.*
.terraform/
crash.*.log
